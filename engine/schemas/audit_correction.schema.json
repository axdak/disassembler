{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "元素字段由 scripts/generation_contract.py 根据正式骨架展开；新增完整，修改局部。",
  "type": "object",
  "properties": {
    "章节": {
      "type": "string"
    },
    "介绍": {
      "type": "object"
    },
    "章节范围": {
      "type": "string",
      "description": "本次治理覆盖的章节范围，如 第001-005章"
    },
    "治理类型": {
      "type": "string",
      "enum": [
        "governance",
        "no_change"
      ],
      "description": "治理类型；无需修改时必须显式声明 no_change"
    },
    "质量说明": {
      "type": "string",
      "description": "已检查范围与结论（no_change 时必填）"
    },
    "证据范围": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "已审计章节列表，如 [\"第001章\", \"第002章\"]（no_change 时必填）"
    },
    "新增元素": {
