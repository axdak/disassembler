    },
    "detail_other": {
      "type": "object",
      "required": [
        "提取理由"
      ],
      "properties": {
        "提取理由": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "关联事件": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^事件:.+"
          }
        },
        "关联其他事项": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^其他事项:.+"
          }
        },
        "关联地点": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^地点:.+"
          }
        },
        "关联物品": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:物品|道具):.+"
          }
        },
        "关联线索": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^线索:.+"
          }
        },
        "关联角色": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^角色:.+"
          }
        },
        "关联阵营": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^阵营:.+"
          }
        },
        "首次章节": {
          "type": "string",
          "pattern": "^\\d{4,}$"
        },
        "最近章节": {
          "type": "string",
          "pattern": "^\\d{4,}$"
        },
        "涉及章节": {
          "type": "string",
          "pattern": "^\\d{4,}(?:，\\d{4,})*$"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(角色|事件|地点|线索|阵营|物品|其他事项|道具):.+"
            }
          }
        ]
      }
    }
  }
}
