          "pattern": "^\\d{4,}$"
        },
        "最近章节": {
          "type": "string",
          "pattern": "^\\d{4,}$"
        },
        "涉及章节": {
          "type": "string",
          "pattern": "^\\d{4,}(?:，\\d{4,})*$"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(角色|事件|地点|线索|阵营|物品|其他事项|道具):.+"
            }
          }
        ]
      }
